# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Compiled service binaries (`go build ./apps/...` drops these at the repo
# root). Built artifacts should never live in the source tree.
/ingress
/bridge
/dxtrade
/loadtest
/loadtest-suite

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Local tool caches
.cache/

# Editor/IDE
.idea/
.vscode/

# Claude Code local state (agent worktrees, local settings)
.claude/

# Python
__pycache__/
*.pyc
*.pyo

# Node
node_modules/
.next/
*.tsbuildinfo

# pytest-cov data files
.coverage
**/.coverage

# Generated binary renders of docs authored in Markdown (the .md is the
# source of truth and is tracked; these binaries are build output).
docs/ARCHITECTURE_AND_COMPARISON.docx
docs/ARCHITECTURE_AND_COMPARISON.pdf

# scripts/local-stack.sh working directory (downloaded nats-server, built
# binaries, logs, pid files)
.local-stack/

# PyInstaller build output for packaging/dashboard/build_exe.py (the .exe
# itself is also covered by the *.exe rule above, but these hold the
# unpacked intermediate build tree too).
/packaging/dashboard/build/
/packaging/dashboard/dist/
/dist/
/build/

# Local dev-only settings for scripts/trade_dashboard.py, scripts/ea_shim.py,
# etc. -- copy config.example.json to config.json and edit; config.json is
# machine-specific and never committed.
/config.json

# Self-signed dev TLS certs from scripts/generate-dev-certs.py (default
# --out ./certs). Regeneratable, never commit a private key. (Ignoring
# `/certs/*` rather than `/certs/` so the !negation below can still see
# inside the directory -- git won't recurse into a wholesale-ignored dir.)
/certs/*
!/certs/.gitkeep

# Generated backtest_ml.py output (HTML report / JSON summary / trades CSV)
# -- see apps/backtester/results/README.md for the convention. Reproducible
# from --candles/--signals inputs plus the tracked model artifact.
apps/backtester/results/*
!apps/backtester/results/.gitkeep
!apps/backtester/results/README.md
!apps/backtester/results/README.docx
